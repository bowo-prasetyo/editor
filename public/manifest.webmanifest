{
  "name": "Plumb",
  "short_name": "Plumb",
  "description": "A private text and code editor that runs in your browser and works offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0969da",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt",
          ".text",
          ".log",
          ".ini",
          ".cfg",
          ".conf",
          ".env",
          ".csv",
          ".tsv",
          ".srt"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "application/json": [
          ".json"
        ],
        "text/x-yaml": [
          ".yaml",
          ".yml"
        ],
        "application/toml": [
          ".toml"
        ],
        "text/xml": [
          ".xml",
          ".svg"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/css": [
          ".css",
          ".scss",
          ".less"
        ],
        "text/javascript": [
          ".js",
          ".mjs",
          ".cjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".vue"
        ],
        "text/x-python": [
          ".py"
        ],
        "text/x-shellscript": [
          ".sh",
          ".bash",
          ".zsh"
        ],
        "text/x-sql": [
          ".sql"
        ],
        "text/x-c": [
          ".c",
          ".h",
          ".cpp",
          ".hpp",
          ".cc",
          ".cs",
          ".java",
          ".go",
          ".rs",
          ".rb",
          ".php",
          ".swift",
          ".kt"
        ],
        "text/x-tex": [
          ".tex"
        ],
        "text/x-rst": [
          ".rst",
          ".adoc",
          ".org"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
